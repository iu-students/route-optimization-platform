              "",
              "// Test 2: Check response is not JSON",
              "pm.test(\"Response is not JSON\", function () {",
              "    const contentType = pm.response.headers.get(\"Content-Type\");",
              "    ",
              "    // Check that Content-Type is NOT application/json",
              "    const isNotJson = !contentType || !contentType.includes(\"application/json\");",
              "    pm.expect(isNotJson).to.be.true;",
              "});",
              "",
              "// Test 3: Validate error details",
              "pm.test(\"Error response provides meaningful details\", function () {",
              "    const contentType = pm.response.headers.get(\"Content-Type\") || \"\";",
              "",
              "    if (contentType.includes(\"application/json\")) {",
              "        // Handle JSON response",
              "        const response = pm.response.json();",
              "        console.log(\"Error response:\", response);",
              "",
              "        if (response.error) {",
              "            pm.expect(response.error).to.be.a(\"string\");",
              "        }",
              "        if (response.message) {",
              "            pm.expect(response.message).to.be.a(\"string\");",
              "        }",
              "        if (response.code) {",
              "            pm.expect(response.code).to.equal(400);",
              "        }",
              "    } else {",
              "        // Handle non-JSON (e.g. HTML) response",
              "        const body = pm.response.text();",
