            "exec": [
              "// Test 1: Check status code is 401 Unauthorized",
              "pm.test(\"Status code is 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "// Test 2: Check error response structure",
              "pm.test(\"Response has error information\", function () {",
              "    const responseText = pm.response.text();",
              "    pm.expect(responseText).to.include(\"Unauthorized\");",
              "});",
              "",
              "// Test 3: Verify error message indicates authentication issue",
              "pm.test(\"Error message indicates authentication failure\", function () {",
              "    const responseText = pm.response.text().toLowerCase();",
              "    pm.expect(responseText).to.satisfy(msg => ",
              "        msg.includes(\"api key\") || ",
              "        msg.includes(\"auth\") || ",
              "        msg.includes(\"unauthorized\") ||",
              "        msg.includes(\"invalid\")",
              "    );",
              "});",
              "",
              "// Test 4: Response time is fast for auth failure",
              "pm.test(\"Auth error response is fast (< 1000ms)\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1000);",
              "});"
