    {
      "name": "Successful Request (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Test 1: Check status code\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Test 2: Check response has required fields\r",
              "pm.test(\"Response has loaders and vehicles arrays\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response).to.have.property(\"loaders\");\r",
              "    pm.expect(response).to.have.property(\"vehicles\");\r",
              "    pm.expect(response.loaders).to.be.an(\"array\");\r",
              "    pm.expect(response.vehicles).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "// Test 3: Validate vehicle route structure\r",
              "pm.test(\"Vehicle route has correct structure\", function () {\r",
              "    const response = pm.response.json();\r",
              "    if (response.vehicles.length > 0) {\r",
              "        const vehicle = response.vehicles[0];\r",
              "        pm.expect(vehicle).to.have.property(\"id\");\r",
              "        pm.expect(vehicle).to.have.property(\"route\");\r",
              "        pm.expect(vehicle).to.have.property(\"time\");\r",
              "        pm.expect(vehicle.route).to.be.an(\"array\");\r",
              "        pm.expect(vehicle.time).to.be.an(\"array\");\r",
              "        // First and last route points should be depot (0)\r",
              "        if (vehicle.route.length > 0) {\r",
              "            pm.expect(vehicle.route[0]).to.equal(0);\r",
              "            pm.expect(vehicle.route[vehicle.route.length - 1]).to.equal(0);\r",
              "        }\r",
              "    }\r",
              "});\r",
              "\r",
              "// Test 4: Validate loader route structure\r",
              "pm.test(\"Loader route has correct structure\", function () {\r",
              "    const response = pm.response.json();\r",
              "    if (response.loaders.length > 0) {\r",
              "        const loader = response.loaders[0];\r",
              "        pm.expect(loader).to.have.property(\"id\");\r",
              "        pm.expect(loader).to.have.property(\"route\");\r",
              "        pm.expect(loader.route).to.be.an(\"array\");\r",
              "    }\r",
              "});\r",
              "\r",
              "// Test 5: Response time is reasonable\r",
              "pm.test(\"Response time is less than 30 seconds\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(30000);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
