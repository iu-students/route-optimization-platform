@startuml sequence-diagram
title Route Optimization Platform - Sequence Diagram (Dynamic View): /solve, /solution, /history

actor "API Client" as Client
participant "Flask API\n(Web/app.py)" as API
participant "Validator\n(Web/validator.py)" as Validator
participant "History\n(Shared/history.py)" as History
participant "Solver Thread" as Thread
participant "Orchestrator\n(CP-SAT/main.py)" as Orchestrator
participant "Vehicle Routes Solver\n(CP-SAT/vehicle_routes.py)" as VehicleSolver
participant "Loader Routes Solver\n(CP-SAT/loader_routes.py)" as LoaderSolver
participant "Verifier\n(Shared/verifier.py)" as Verifier
database "Data Storage\n(input/output.json,\ninputs/, outputs/)" as Storage
database "history.db" as DB

== POST /solve ==

Client -> API : POST /solve (X-API-Key, payload)
activate API
API -> Validator : validate_input(data)
Validator --> API : ok / ValidationError

alt validation failed
  API --> Client : 400 {errors}
else validation ok
  API -> History : start_calculation() -> calculation_id
  History -> DB : INSERT status="processing"
  History -> Storage : write inputs/{id}.json
  API -> Storage : write input.json (scratch)
  API -> Thread : start(run_solve, calculation_id)
  activate Thread
  API --> Client : 202 {status: started, calculation_id}
  deactivate API

  Thread -> Orchestrator : solve_pipeline(..., deadline=now+max_total_time)
  activate Orchestrator
  Orchestrator -> Thread : stage="parsing" ; parse(input.json)
  Orchestrator -> Orchestrator : size-scaled restarts + pool budgets (n=orders)
  Orchestrator -> VehicleSolver : ortools_generate_routes() (optional, one-time seed)
  VehicleSolver --> Orchestrator : seed_routes

  Orchestrator -> Thread : stage="solving"
  loop multi-start: while time remains for an attempt
    Orchestrator -> Thread : stage="solving_vehicles"
    Orchestrator -> VehicleSolver : find_vehicles_routes(scenario, deadline, seed_routes)
    note right: Clarke-Wright pool + insertion\n+ CP-SAT set-partition select
    VehicleSolver --> Orchestrator : solution, pool
    Orchestrator -> Thread : stage="consolidating_vehicles"
    Orchestrator -> VehicleSolver : consolidate + reduce_by_merge +\nlocal_search + merge_multi_trip
    VehicleSolver --> Orchestrator : post-processed vehicles
    Orchestrator -> Thread : stage="solving_loaders"
    Orchestrator -> LoaderSolver : find_loaders_routes(solution, scenario, deadline)
    LoaderSolver --> Orchestrator : loaders
    Orchestrator -> Orchestrator : calculate_statistics(solution)
    alt bad orders on vehicle AND/OR loader side, time left ok
      Orchestrator -> Thread : stage="feedback_iteration"
      Orchestrator -> VehicleSolver : select_routes_from_pool(filtered_pool, reduced)
      VehicleSolver --> Orchestrator : solution2
      Orchestrator -> LoaderSolver : find_loaders_routes(solution2, reduced)
      LoaderSolver --> Orchestrator : loaders2
      Orchestrator -> Orchestrator : keep cheaper of solution / solution2
    end
    Orchestrator -> Orchestrator : keep attempt if real total_cost < best so far
  end

  Orchestrator -> Orchestrator : LNS polish loop (remaining time):\nlocal_search + re-solve loaders;\naccept if improved, else perturb best
  Orchestrator -> Storage : write output.json
  Orchestrator -> Verifier : run_verification(input_path, output_path)
  Verifier -> Storage : read input.json + output.json
  Verifier --> Orchestrator : verification result
  Orchestrator -> Storage : write output.json (+ verification)
  Orchestrator -> Thread : stage="done"
  Orchestrator --> Thread : solution
  deactivate Orchestrator

  Thread -> History : finish_success(id, output, exec_time, cost)
  History -> Storage : write outputs/{id}.json
  History -> DB : UPDATE status="success", ...
  Thread -> Thread : solver_state = done
  deactivate Thread
end

alt exception raised in run_solve()
  Thread -> Thread : solver_state = error
  Thread -> History : finish_error(id, message, exec_time)
  History -> Storage : write outputs/{id}.json ({"error": ...})
  History -> DB : UPDATE status="error"
end

== GET /solution (polling) ==

Client -> API : GET /solution
activate API
alt computing
  API --> Client : 200 {computing, calculation_id, stage}
else done
  API -> Storage : read output.json
  API --> Client : 200 {done, solution}
else error
  API --> Client : 500 {error, message}
else idle
  API --> Client : 200 {idle}
end
deactivate API

== GET /history  /  GET /history/{id} ==

Client -> API : GET /history
activate API
API -> History : get_all()
History -> DB : SELECT ... ORDER BY calculation_id DESC
History --> API : summary list
API --> Client : 200 {history: [...]}
deactivate API

Client -> API : GET /history/{calculation_id}
activate API
API -> History : get_by_id(calculation_id)
History -> DB : SELECT * WHERE calculation_id = ?
alt found
  History -> Storage : read input/output JSON
  History --> API : full record
  API --> Client : 200 {record}
else not found
  History --> API : null
  API --> Client : 404 {message: "Not found"}
end
deactivate API

@enduml
